# Настройки ассистента. Скопируй в .copilot.env в КОРНЕ проекта и впиши ключи.
# Уже заданные переменные окружения имеют приоритет над этим файлом.

# Основной «мозг»: ollama | groq | deepseek | anthropic | openrouter
COPILOT_PROVIDER=groq
GROQ_API_KEY=

# Сильная модель для режима «умнее»: anthropic | deepseek | ...
COPILOT_STRONG=deepseek
DEEPSEEK_API_KEY=

# Ключ Claude (если COPILOT_STRONG=anthropic)
# ANTHROPIC_API_KEY=
