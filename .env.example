# ===== SPECTO bot — переменные окружения =====
# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- Claude (Anthropic) ---
# Ключ API для генерации ответов менеджера «Алина».
# Получить: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram ---
# Токен бота от @BotFather.
TELEGRAM_TOKEN=123456:ABC-DEF...

# --- WhatsApp (Meta / Facebook Graph API) ---
# Постоянный токен доступа WhatsApp Cloud API.
WHATSAPP_TOKEN=EAAG...
# ID номера телефона из WhatsApp Cloud API (Phone number ID).
PHONE_NUMBER_ID=1234567890
# Произвольная строка для верификации webhook'а WhatsApp.
# Должна совпадать со значением, указанным в настройках вебхука Meta.
VERIFY_TOKEN=my_bot_token_123

# --- Supabase (хранилище лидов и истории диалогов) ---
# Если не заданы — бот работает в локальном режиме (orders.json + память).
# URL проекта: Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://lxmhjqnxzocehjrqurfq.supabase.co
# service_role ключ (НЕ anon!): Project Settings → API → service_role.
# Нужен, потому что таблицы specto_bot_* защищены RLS. Держите в секрете.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# --- Сервер / деплой ---
# Порт HTTP-сервера (по умолчанию 3000).
PORT=3000
# Публичный домен Railway — используется для автоматической установки
# Telegram webhook при старте. На Railway подставляется автоматически.
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
