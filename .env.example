# --- ИИ-квалификация лидов (leads.ai_qual_*) ---
# Поллер выключен по умолчанию. Включить: QUAL_ENABLED=1
QUAL_ENABLED=0
# Период прогона поллера, мс (по умолчанию 5 минут)
QUAL_INTERVAL_MS=300000
# Окно отбора чатов: сколько минут назад смотреть whatsapp_messages (по умолчанию 60)
QUAL_LOOKBACK_MIN=60
# Максимум лидов за один прогон поллера (по умолчанию 10)
QUAL_BATCH=10

