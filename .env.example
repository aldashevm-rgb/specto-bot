# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Необязательно, по умолчанию claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# --- Supabase (проект "CRM Specto") ---
# service_role ключ — у таблиц specto_bot_* включён RLS, доступ только под ним.
SUPABASE_URL=https://lxmhjqnxzocehjrqurfq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=EAAG...
PHONE_NUMBER_ID=1234567890
VERIFY_TOKEN=my_bot_token_123
WHATSAPP_APP_SECRET=...

# --- Догоняющие сообщения и «стоп» ---
# Глобальный рубильник проактивных сообщений. По умолчанию ВКЛ.
# FOLLOWUPS_ENABLED=0 — бот вообще никому не пишет сам (на входящие отвечает).
FOLLOWUPS_ENABLED=1
# Стоп-лист номеров: поставщики, партнёры, сотрудники, свои номера. Этим
# контактам бот не пишет ни сам, ни в ответ — только сохраняет переписку.
# Разделители — запятая/точка с запятой/перевод строки (пробелы внутри номера
# допустимы). Сравнение по последним 10 цифрам, формат любой.
# Пример: FOLLOWUP_BLOCKLIST=77011234567, +7 702 000-00-00
FOLLOWUP_BLOCKLIST=

# --- ИИ-квалификация лидов (leads.ai_qual_*) ---
# Поллер выключен по умолчанию. Включить: QUAL_ENABLED=1
QUAL_ENABLED=0
# Период прогона поллера, мс (по умолчанию 5 минут)
QUAL_INTERVAL_MS=300000
# Окно отбора чатов: сколько минут назад смотреть whatsapp_messages (по умолчанию 60)
QUAL_LOOKBACK_MIN=60
# Максимум лидов за один прогон поллера (по умолчанию 10)
QUAL_BATCH=10

# --- Агент-сторож (мониторинг + авто-ремонт квалификации) ---
# Чинит пропуски, переоценивает устаревшие и сомнительные оценки, мониторит здоровье.
# Выключен по умолчанию. Включить: WATCHDOG_ENABLED=1
WATCHDOG_ENABLED=0
# Период прогона сторожа, мс (по умолчанию 1 час)
WATCHDOG_INTERVAL_MS=3600000
# Максимум (пере)оценок за один прогон сторожа — бюджет на Claude (по умолчанию 20)
WATCHDOG_BATCH=20
# Необязательно: вебхук для алертов (Slack/Telegram-бридж, формат {"text": "..."}).
# Если не задан — алерты только в логи.
WATCHDOG_ALERT_WEBHOOK=
# «Застрявшие» лиды: горячий лид (score >= STUCK_MIN_SCORE), где клиент написал
# последним и менеджер молчит дольше STUCK_HOURS часов → алерт.
WATCHDOG_STUCK_HOURS=4
WATCHDOG_STUCK_MIN_SCORE=60
# Авто-назначение менеджера горячим ничьим лидам (корзина «director»).
# Стратегия — наименее загруженному активному менеджеру проекта. Выключено по умолчанию.
AUTOASSIGN_ENABLED=0
AUTOASSIGN_MIN_SCORE=60
# Ежедневная сводка по лидам (всего/горячих/новых, рубрики, топ-5). Шлётся раз
# в день, когда UTC-час >= DIGEST_HOUR. Выключена по умолчанию.
DIGEST_ENABLED=0
DIGEST_HOUR=6

# --- Прочее ---
ORDERS_API_KEY=
PORT=3000
# Код страны для кнопок дозвона на дашборде /hot (номера без международного
# префикса дополняются им). По умолчанию 7 (Казахстан/Россия).
DASHBOARD_COUNTRY_CODE=7