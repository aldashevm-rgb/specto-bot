+});
+
+test("hasEnoughSignal: нужна хотя бы одна реплика клиента", () => {
+  assert.equal(hasEnoughSignal([{ direction: "out", text: "Привет" }]), false);
+  assert.equal(hasEnoughSignal([{ direction: "in", text: "Привет" }]), true);
