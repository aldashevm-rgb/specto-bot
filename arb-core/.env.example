# --- Источник коэффициентов: The Odds API (https://the-odds-api.com) ---
# Бесплатный тариф даёт ключ и лимит запросов. Обязателен для реального скана.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4

# --- Источник статистики: API-Football (https://www.api-football.com) ---
# Нужен для ИИ-разбора мотивации (форма, положение в таблице). Опционален.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# --- ИИ-разбор матча (Claude) ---
# Без ключа сканер всё равно ищет вилки, но без слоя «кому нужна победа».
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Уведомления в Telegram (опционально) ---
# Создать бота у @BotFather → токен; chat_id — id чата/канала для алертов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ARB_NOTIFY_MARGIN=1.0   # слать уведомление только для вилок с маржой ≥ этого %, %
ARB_WATCH_MS=1800000    # интервал вотчера (npm run watch) в мс (по умолч. 30 мин; для сервера ≥7200000)
ARB_WATCH_SPORT=upcoming # что сканирует вотчер на сервере (без CLI-аргумента)
ARB_WATCH_SHARP=        # =1 — вотчер шлёт только value у резких контор

# --- Лог вилок в Supabase (опционально) ---
# Применить schema.sql в проекте. Ключ — service_role (обходит RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ARB_TABLE=arb_surebets

# --- Ансамбль прогноза (веса источников, в сумме нормируются) ---
ARB_W_CONSENSUS=0.7     # консенсус рынка без маржи (сильнейший предиктор — доминирует)
ARB_W_MODEL=0.15        # модель Пуассона (форма из 5 матчей — слабый сигнал, малый вес)
ARB_W_AI=0.15           # LLM-разбор (мотивация, вероятный исход)
ARB_POISSON_MAXGOALS=10 # верх сетки счётов для модели Пуассона

# --- Параметры сканера ---
ARB_MAX_HOURS=72        # окно до начала матча, ч (0 = без ограничения; отсекает сырые futures-линии)

# --- Автогрейдинг (локальный лог, без облака) ---
# ARB_LOG_FILE=predictions.jsonl   # путь к логу прогнозов (по умолчанию в папке arb-core)
ARB_SCORES_DAYS=3       # за сколько последних суток брать результаты матчей (1–3)

# --- Kelly-стейкинг (размер ставки от банка) ---
ARB_BANKROLL=1000       # размер банка
ARB_KELLY_FRACTION=0.25 # доля Кельли (0.25 = четверть-Кельли; безопаснее полного)
ARB_KELLY_MAX=0.05      # потолок доли банка на одну ставку (защита от переставки)
ARB_MIN_MARGIN=0.5      # минимальная маржа вилки в % (ниже — отсекаем)
ARB_MIN_EDGE=2          # мин. value-перевес у РЕЗКИХ контор (Pinnacle/Betfair…), %
ARB_MIN_EDGE_SOFT=4     # выше порог у СОФТ-контор (щедрые, но лимитируют), %
ARB_STAKE=1000          # банк на событие для раскладки ставок
ODDS_REGION=eu          # регион букмекеров: eu | uk | us | au
ODDS_MARKET=h2h,totals  # рынки через запятую: h2h,totals,spreads
